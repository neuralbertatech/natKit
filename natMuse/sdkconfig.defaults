# Partition table - use larger single app partition for debug builds
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# Flash size - 4MB standard
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Bluetooth configuration for Muse BLE client

# Enable Bluetooth
CONFIG_BT_ENABLED=y

# Use NimBLE stack (lighter than Bluedroid, sufficient for BLE-only)
CONFIG_BT_NIMBLE_ENABLED=y

# BLE only mode (no classic Bluetooth)
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y

# NimBLE configuration
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MAX_BONDS=1
CONFIG_BT_NIMBLE_MAX_CCCDS=8
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y

# Increase attribute data length for Muse packets (20 bytes)
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=256

# Enable GATT client
CONFIG_BT_NIMBLE_GATT_CLI_ENABLED=y

# Enable GAP and GATT services
CONFIG_BT_NIMBLE_GAP_DEVICE_NAME_MAX_LEN=31
CONFIG_BT_NIMBLE_SVC_GAP_ENABLED=y
CONFIG_BT_NIMBLE_SVC_GATT_ENABLED=y

# Logging
CONFIG_BT_NIMBLE_LOG_LEVEL=1

# Memory optimization
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_INTERNAL=y

# WiFi/BLE Coexistence - prioritize BLE for stable Muse connection
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
CONFIG_SW_COEXIST_ENABLE=y

# WiFi settings for better BLE coexistence
CONFIG_ESP_WIFI_SW_COEXIST_ENABLE=y
