# natKit Docker Compose Environment Configuration
# Copy this file to .env and update with your settings

# Host IP address for remote Kafka access
# Set this to your machine's IP address if you need devices (e.g., ESP32) to connect
# from the network. Leave as 127.0.0.1 for local-only development.
NATKIT_HOST_IP=127.0.0.1

# Example: For a machine at 192.168.1.100
# NATKIT_HOST_IP=192.168.1.100
