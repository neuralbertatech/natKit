FROM docker.io/library/node:20-alpine
WORKDIR /app

COPY package*.json ./
RUN npm ci

# Source is bind-mounted over this at runtime (see docker-compose.dev.yml);
# this COPY just keeps `docker build` usable standalone.
COPY . ./

EXPOSE 5173

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]
