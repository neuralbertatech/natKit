// Development Configuration for natVR EMG firmware
//
// Copy this file to DevConfig.hpp and update with your local settings.
// DevConfig.hpp is gitignored and should not be committed.

#ifndef NATVR_FIRMWARE_DEV_CONFIG_HPP
#define NATVR_FIRMWARE_DEV_CONFIG_HPP

#define WIFI_SSID "your_wifi_ssid"
#define WIFI_PASSWORD "your_wifi_password"

#define MQTT_BROKER_HOST "192.168.1.100"
#define MQTT_BROKER_PORT 1883

#define NATVR_EMG_DEVICE_ID "emg01"
#define NATVR_STATUS_DEVICE_ID "emg01-fw"
// ESP32-C3: 1 -> GPIO4 only, 2 -> GPIO4 + GPIO3, 3 -> GPIO4 + GPIO3 + GPIO1.
#define NATVR_ADC_CHANNEL_COUNT 1

#define NATVR_NTP_SERVER "pool.ntp.org"

#endif  // NATVR_FIRMWARE_DEV_CONFIG_HPP
