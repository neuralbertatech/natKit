{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuralberta.tech/schemas/natvr/hand-state-v1.schema.json",
  "title": "natVR Hand State v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "gesture_id",
    "confidence",
    "curls",
    "source_window_start_us",
    "source_window_end_us",
    "emitted_at_us"
  ],
  "properties": {
    "schema_version": {
      "const": "hand.state.v1"
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "gesture_id": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "curls": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "number",
        "minimum": 0.0,
        "maximum": 1.0
      }
    },
    "source_window_start_us": {
      "type": "integer",
      "minimum": 0
    },
    "source_window_end_us": {
      "type": "integer",
      "minimum": 0
    },
    "emitted_at_us": {
      "type": "integer",
      "minimum": 0
    },
    "source_device_id": {
      "type": "string",
      "minLength": 1
    }
  }
}
