;; natKit ClojureScript frontend — Visual Programming.
;;
;; Dependency source of truth. shadow-cljs reads this via `:deps true` in
;; shadow-cljs.edn, so there is one dep file that also serves `clj -M:test`,
;; clj-kondo and nREPL tooling.
;;
;; The stack mirrors rvbbit (github.com/ryrobes/rvbbit) — see
;; plans/clojurescript-vp-frontend-plan.html §5.2 for why each of these is here
;; rather than hand-rolled.
{:paths ["src/main" "resources"]

 :deps
 {org.clojure/clojure       {:mvn/version "1.12.0"}
  org.clojure/clojurescript {:mvn/version "1.11.132"}
  ;; The build tool itself. With `:deps true` in shadow-cljs.edn the npm
  ;; `shadow-cljs` launcher runs via the Clojure CLI, so the JVM side must be a
  ;; declared dependency here. Keep this version in lockstep with package.json.
  thheller/shadow-cljs {:mvn/version "2.28.20"}

  ;; --- UI + state -------------------------------------------------------
  reagent/reagent {:mvn/version "1.2.0"}
  re-frame/re-frame {:mvn/version "1.4.3"}
  ;; Layout primitives (h-box/v-box/gap) so the design system is about
  ;; identity, not flex plumbing. Upstream, NOT rvbbit's fork.
  re-com/re-com {:mvn/version "2.22.11"}
  ;; Theme-as-data: the theme map compiles to CSS at runtime.
  garden/garden {:mvn/version "1.3.10"}

  ;; --- Scripting --------------------------------------------------------
  ;; Small Clojure Interpreter: the `script_sci` runner. Sandboxed BY
  ;; CONSTRUCTION — the evaluation context is an explicit allow-list of vars and
  ;; namespaces, with no host interop unless granted. That property is why the
  ;; ClojureScript script node can ship ahead of the Python one.
  org.babashka/sci {:mvn/version "0.9.44"}

  ;; --- Protocol ---------------------------------------------------------
  ;; Schemas for the WS message/action unions + StreamGraphDefinition. Dev-time
  ;; assertion at the socket boundary; compiled out of :release.
  metosin/malli {:mvn/version "0.16.4"}

  ;; --- re-frame infrastructure (§5.2 table) -----------------------------
  ;; WebSocket as re-frame effects/events — replaces the hand-rolled
  ;; StreamViewerWebSocket class (reconnect, backoff, dispatch).
  org.clojars.rutledgepaulv/websocket-fx {:mvn/version "0.1.2"}
  ;; Declarative polling — replaces setInterval driving get_stream_graph_status.
  re-pollsive/re-pollsive {:mvn/version "0.1.0"}
  ;; Undo/redo on the graph editor. The Svelte editor has none.
  day8.re-frame/undo {:mvn/version "0.3.3"}
  ;; Declarative keybindings, incl. the ⌘K palette.
  re-pressed/re-pressed {:mvn/version "0.3.2"}}

 :aliases
 {:dev {:extra-deps {binaryage/devtools {:mvn/version "1.0.7"}}}
  :test {:extra-paths ["test"]}}}
